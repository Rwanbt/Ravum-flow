{
  "schema": "flow-config/1",
  "policy_version": "FLOW-POLICY-1",
  "execution_boundary": "local-trusted",
  "obligations": [
    {
      "id": "fmt",
      "program": "cargo",
      "args": ["fmt", "--check"],
      "required": true,
      "timeout_s": 120
    },
    {
      "id": "clippy",
      "program": "cargo",
      "args": ["clippy", "--", "-D", "warnings"],
      "required": true,
      "timeout_s": 300
    },
    {
      "id": "test",
      "program": "cargo",
      "args": ["test", "--locked", "--offline"],
      "required": true,
      "timeout_s": 300
    }
  ],
  "disabled": false
}
