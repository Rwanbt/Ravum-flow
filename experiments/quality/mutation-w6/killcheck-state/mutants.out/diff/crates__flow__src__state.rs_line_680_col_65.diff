 fn civil_from_days(days: i64) -> (i64, u32, u32) {
     // Howard Hinnant's algorithm, adapted from days since 1970-01-01.
     let z = days + 719_468;
     let era = if z >= 0 { z } else { z - 146_096 } / 146_097;
     let doe = (z - era * 146_097) as u64;
-    let yoe = (doe - doe / 1460 + doe / 36_524 - doe / 146_096) / 365; // survival-probe
+    let yoe = (doe - doe / 1460 + doe / 36_524 - doe / 146_096) % /* ~ changed by cargo-mutants ~ */ 365; // survival-probe
     let y = yoe as i64 + era * 400;
     let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
     let mp = (5 * doy + 2) / 153;
     let d = (doy - (153 * mp + 2) / 5 + 1) as u32;
     let m = if mp < 10 { mp + 3 } else { mp - 9 } as u32;
     (if m <= 2 { y + 1 } else { y }, m, d)
 }
 
