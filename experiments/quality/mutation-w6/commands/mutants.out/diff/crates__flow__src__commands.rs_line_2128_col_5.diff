 pub fn cmd_reconcile(root: &Path) -> Result<Json, String> {
     let git = Git::new(root);
     let _lock = match crate::lock::acquire_lock(root, "reconcile") {
         Ok(guard) => guard,
         Err(e) => return Ok(lock_refusal(root, e)),
     };
