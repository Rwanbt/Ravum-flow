 pub fn load_config(root: &Path) -> Result<Config, String> {
     let path = config_path(root);
     let text = fs::read_to_string(&path)
         .map_err(|e| format!("not initialized: cannot read {}: {e}", path.display()))?;
     Config::from_json(&json::parse(&text)?)
 }
