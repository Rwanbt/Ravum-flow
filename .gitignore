/target/
/node_modules/
/.venv/
/.pytest_cache/
/dist/
/build/
*.log
*.tmp
.env
.env.*
!.env.example

# R0 harness generated trees (rebuild with experiments/r0a/run_r0a.py)
/experiments/r0a/work/

__pycache__/
*.pyc


# R0-b scratch repositories and S9 generated trees (rebuildable, never committed)
/experiments/r0b/*/scratch/
/experiments/s9/work/
/experiments/r0b/*/fixtures/**/.git/


# R0-b git fixtures are rebuilt by experiments/r0b/git/run_tests.py
/experiments/r0b/git/fixtures/
dist/

# Coverage instrumentation leaves profile data next to the binary
*.profraw

# Coverage target used by the documented measurement command (summary-*.txt)
/wt-quality-target/

# wave-6 mutation evidence: per-mutant test logs and cargo-mutants debug traces are
# large and regenerable from the committed outcomes (rerun with --iterate).
/experiments/quality/mutation-w6/**/log/
/experiments/quality/mutation-w6/**/debug.log
/experiments/quality/mutation-w6/**/mutants.out.old/
/experiments/quality/mutation-w6/**/baseline.log

# wave-7 mutation evidence: same rule as wave 6 — per-mutant logs are regenerable from the
# committed outcomes, and an interrupted run's mutants.out.old is not evidence.
/experiments/quality/mutation-w7/**/log/
/experiments/quality/mutation-w7/**/debug.log
/experiments/quality/mutation-w7/**/mutants.out.old/
/experiments/quality/mutation-w7-linux/**/log/
/experiments/quality/mutation-w7-linux/**/debug.log

